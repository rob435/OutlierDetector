# Every setting is optional; the values shown are the defaults.
# Real environment variables take precedence over this file.

# --- Telegram (alerts go to the log only if unset) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Universe ---
# Comma-separated list, e.g. SOLUSDT,WIFUSDT. Empty = the UNIVERSE_SIZE most-traded
# USDT perpetuals with at least MIN_TURNOVER_USD of 24h turnover.
SYMBOLS=
UNIVERSE_SIZE=100
MIN_TURNOVER_USD=10000000

# --- Detection ---
INTERVAL_MINUTES=15
# Range, volatility and typical-volume window (96 x 15m = 24h).
LOOKBACK_BARS=96
# Move window, including the forming bar (4 x 15m = 1h).
IMPULSE_BARS=4
# Market-relative move, in multiples of the symbol's own volatility.
MIN_ZSCORE=3.0
# Absolute move over the impulse window, in percent.
MIN_MOVE_PCT=1.0
# Bar turnover vs. the median bar, pro-rated while the bar is forming.
MIN_RVOL=2.0
# Never pro-rate volume as if less than this fraction of the bar has elapsed.
MIN_ELAPSED_FRACTION=0.2
DETECT_BREAKDOWNS=true
# Alert on the forming bar; set false for close-confirmed alerts only.
EARLY_ALERTS=true
# Per symbol, direction and stage.
COOLDOWN_MINUTES=240

# --- Runtime ---
SCAN_INTERVAL_SECONDS=0.5
CLOSE_GRACE_SECONDS=10.0
STALE_STREAM_SECONDS=60.0
BOOTSTRAP_CONCURRENCY=10
BYBIT_REST_URL=https://api.bybit.com
BYBIT_WS_URL=wss://stream.bybit.com/v5/public/linear

# --- Output ---
SQLITE_PATH=signals.sqlite3
LOG_LEVEL=INFO
